#!/bin/sh
# User-local Factory usage runner deployed with the factory.usage-service
# plugin. Runs this plugin's own collector against the installed vendor
# bundle (explicit --bundle: a helper outside /opt must never derive the
# bundle root from its own script location). Override the bundle with
# FACTORY_DESKTOP_BUNDLE when needed.
set -eu
PLUGIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BUNDLE="${FACTORY_DESKTOP_BUNDLE:-/opt/factory-desktop-arch}"
# -B: never write __pycache__ into the fingerprint-verified payload.
exec python3 -B "$PLUGIN_DIR/runtime/collector.py" --bundle "$BUNDLE" "$@"
